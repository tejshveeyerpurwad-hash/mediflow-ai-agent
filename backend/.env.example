# ── Required ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string
AADHAAR_SALT=change-me-to-a-random-32-char-string
AGENT_SECRET=change-me-to-a-random-32-char-string
GROQ_API_KEY=gsk_your_groq_api_key_here
ADMIN_PASSCODE=change-me-to-a-secure-passcode

# ── AI Service ────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── PostgreSQL / Aurora (optional — SQLite fallback) ──
DATABASE_URL=postgresql://user:password@localhost:5432/mediflow
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mediflow

# ── AWS (production only) ─────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── DynamoDB (production only) ────────────────────────
DYNAMODB_TABLE_PREFIX=mediflow

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Twilio (optional — for SMS OTP) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google Maps (optional — for hospital location) ────
GOOGLE_MAPS_API_KEY=

# ── Optional ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
NODE_CLUSTER_WORKERS=1
ENABLE_DEEP_MODEL=false
FORCE_DB_CONNECTED=false
